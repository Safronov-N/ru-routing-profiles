# Сгенерировано из shadowrocket.conf и rules/*.list; не редактировать вручную.
name: 'Independent RU Routing'
desc: 'Маршрутизация для РФ. Выберите свой VPN-сервер в группе RU-PROXY.'
mode: rule

# Группа использует серверы и провайдеров действующей подписки.
# До подключения выберите рабочий сервер; пустая подписка не поддерживается.
proxy-groups:
  - name: RU-PROXY
    type: select
    include-all: true

rule-providers:
  ru-proxy-domain:
    type: http
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Safronov-N/ru-routing-profiles/main/stash/rules/proxy-domain.yaml
    path: ./rule-providers/ru-proxy-domain.yaml
    interval: 21600
  ru-direct-priority-domain:
    type: http
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Safronov-N/ru-routing-profiles/main/stash/rules/direct-priority-domain.yaml
    path: ./rule-providers/ru-direct-priority-domain.yaml
    interval: 21600
  ru-proxy-refilter-community:
    type: http
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Safronov-N/ru-routing-profiles/main/stash/rules/proxy-refilter-community.yaml
    path: ./rule-providers/ru-proxy-refilter-community.yaml
    interval: 21600
  ru-proxy-refilter-domain:
    type: http
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Safronov-N/ru-routing-profiles/main/stash/rules/proxy-refilter-domain.yaml
    path: ./rule-providers/ru-proxy-refilter-domain.yaml
    interval: 21600
  ru-direct-domain:
    type: http
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Safronov-N/ru-routing-profiles/main/stash/rules/direct-domain.yaml
    path: ./rule-providers/ru-direct-domain.yaml
    interval: 21600
  ru-direct-foreign-domain:
    type: http
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Safronov-N/ru-routing-profiles/main/stash/rules/direct-foreign-domain.yaml
    path: ./rule-providers/ru-direct-foreign-domain.yaml
    interval: 21600
  ru-direct-ip:
    type: http
    behavior: ipcidr
    format: yaml
    url: https://raw.githubusercontent.com/Safronov-N/ru-routing-profiles/main/stash/rules/direct-ip.yaml
    path: ./rule-providers/ru-direct-ip.yaml
    interval: 21600

# Замена исключает перехват трафика прежними правилами подписки.
rules: #!replace
  - 'IP-CIDR,10.0.0.0/8,DIRECT,no-resolve'
  - 'IP-CIDR,100.64.0.0/10,DIRECT,no-resolve'
  - 'IP-CIDR,127.0.0.0/8,DIRECT,no-resolve'
  - 'IP-CIDR,169.254.0.0/16,DIRECT,no-resolve'
  - 'IP-CIDR,172.16.0.0/12,DIRECT,no-resolve'
  - 'IP-CIDR,192.168.0.0/16,DIRECT,no-resolve'
  - 'IP-CIDR6,::1/128,DIRECT,no-resolve'
  - 'IP-CIDR6,fc00::/7,DIRECT,no-resolve'
  - 'IP-CIDR6,fe80::/10,DIRECT,no-resolve'
  - 'DOMAIN-SUFFIX,2ip.ru,RU-PROXY'
  - 'DOMAIN-SUFFIX,2ip.io,RU-PROXY'
  - 'DOMAIN-SUFFIX,ipify.org,RU-PROXY'
  - 'DOMAIN-SUFFIX,ifconfig.me,RU-PROXY'
  - 'DOMAIN-SUFFIX,ip.sb,RU-PROXY'
  - 'DOMAIN-SUFFIX,checkip.amazonaws.com,RU-PROXY'
  - 'DOMAIN-SUFFIX,ipapi.is,RU-PROXY'
  - 'DOMAIN-SUFFIX,iplocate.io,RU-PROXY'
  - 'DOMAIN-SUFFIX,showip.net,RU-PROXY'
  - 'DOMAIN-WILDCARD,chatgpt-async-webps-prod-*-*.webpubsub.azure.com,RU-PROXY'
  - 'RULE-SET,ru-proxy-domain,RU-PROXY'
  - 'RULE-SET,ru-direct-priority-domain,DIRECT'
  - 'RULE-SET,ru-proxy-refilter-community,RU-PROXY'
  - 'DOMAIN-SUFFIX,ru,DIRECT'
  - 'DOMAIN-SUFFIX,xn--p1ai,DIRECT'
  - 'DOMAIN-SUFFIX,su,DIRECT'
  - 'DOMAIN-SUFFIX,by,DIRECT'
  - 'RULE-SET,ru-proxy-refilter-domain,RU-PROXY'
  - 'RULE-SET,ru-direct-domain,DIRECT'
  - 'RULE-SET,ru-direct-foreign-domain,DIRECT'
  - 'RULE-SET,ru-direct-ip,DIRECT'
  - 'GEOIP,RU,DIRECT'
  - 'MATCH,RU-PROXY'
